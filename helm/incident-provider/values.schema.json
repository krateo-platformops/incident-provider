{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "incident-provider chart values",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "title": "Global values"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string", "description": "Defaults to the chart appVersion." },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debug": { "type": "boolean" },
        "pollInterval": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h)$" },
        "settleWindow": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h)$" },
        "noVerdictRuns": { "type": "integer", "minimum": 0, "maximum": 2147483647, "description": "Consecutive runs without exit 0 or 1 that stop the current script; 0 disables." },
        "noVerdictFor": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h)$", "description": "How long runs may give no exit 0 or 1 before the current script stops; 0s disables." },
        "alertGoneGrace": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h)$", "description": "How long the Alert must stay NotFound before an Open or Verifying incident is closed by alert-gone." },
        "retention": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h)$", "description": "How long a Closed or Resolved Incident is kept after status.resolution.at before it is deleted; 0s keeps them for ever." },
        "syncPeriod": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h)$" },
        "maxReconcileRate": { "type": "integer", "minimum": 1 },
        "leaderElection": { "type": "boolean" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "apply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "ttl": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h)$" },
        "credentialsNamespace": { "type": "string" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "createNamespace": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "serviceAccount": { "type": "string", "minLength": 1 },
        "clusterRoles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readerRefresh": {
          "type": "string",
          "pattern": "^[0-9]+(ns|us|ms|s|m|h)$",
          "description": "How often the controller rewrites the check reader ClusterRole from discovery: reads on every resource but Secrets and subresources."
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string", "description": "Defaults to the chart appVersion." },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "object" }
        },
        "resources": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "apiServer": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cidr": { "type": "string" },
                  "ports": { "type": "array", "items": { "type": "integer" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
